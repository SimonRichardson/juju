#!/bin/sh
set -eu

event=${HOLISTIC_EVENT:-${JUJU_HOOK_NAME:-$(basename "$0")}}
message=$(config-get message 2>/dev/null || printf '%s' holistic)

status-set maintenance "holistic reconcile: ${event}" || true
juju-log "holistic reconcile event=${event} message=${message}" || true

# The command is supplied by the holistic runtime. Keep this charm runnable
# with the legacy test harness while making the snapshot handoff observable.
if command -v unit-snapshot >/dev/null 2>&1; then
	unit-snapshot >/dev/null
fi

status-set active "holistic: ${event}" || true
